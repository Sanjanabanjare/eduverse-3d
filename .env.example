# EduVerse 3D — environment template.
# Copy to `.env` and fill in ONLY the values you need. Never commit `.env`.
# Every variable is optional for local use (sane fallbacks apply); the
# production-required ones are marked REQUIRED in production.
# NEVER paste real keys into chat, docs, or screenshots — put them here only.

# --- Running the server -----------------------------------------------------
# Port the app listens on (default 4173).
PORT=4173
# Set to `production` when deploying. Production REFUSES to start without
# JWT_SECRET (32+ chars) and APP_BASE_URL, and refuses the 123456 setup code.
NODE_ENV=development
# Where the JSON store lives (default backend/data/store.json). Back this file up.
EDUVERSE_STORE_PATH=

# --- Production secrets (REQUIRED in production) -----------------------------
# Random secret for signing JWTs — generate 32+ characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Public address of your deployment, e.g. https://eduverse.example.com
APP_BASE_URL=
# First-admin setup code (32+ characters in production; defaults to 123456 locally).
EDUVERSE_ADMIN_SETUP_CODE=

# --- AI (Nova) ---------------------------------------------------------------
# Without this, Nova answers with built-in local logic. Rotate any key that
# was ever shared in chat before using it here.
OPENAI_API_KEY=
# Model override (default gpt-4o-mini).
NOVA_MODEL=gpt-4o-mini

# --- Google sign-in (optional) -----------------------------------------------
# Without these, the Google button stays hidden. Get them from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Live classroom video (optional) -----------------------------------------
# Default is built-in WebRTC. Set VIDEO_PROVIDER=agora to use Agora instead.
VIDEO_PROVIDER=
AGORA_APP_ID=
AGORA_APP_CERT=

# --- Coding lab, non-JS languages (optional) ---------------------------------
# Without Judge0, only JavaScript runs (locally, in a sandbox). Set these to
# enable Python/Java/C++/C/Go/Ruby/Rust via Judge0.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Set to `false` to disable ALL server-side code execution (public deployments
# that don't trust the sandbox). Default: enabled.
CODE_EXEC_ENABLED=true

# --- Payments (optional) -----------------------------------------------------
# Without keys, orders run in test mode. Set one provider to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET=

# --- Email (optional) --------------------------------------------------------
# Without a provider, mail goes to the admin dev outbox. Set EMAIL_PROVIDER to
# `resend` or `sendgrid` plus the matching key to send real email.
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@eduverse.local

# --- Storage / cache / monitoring (optional) ---------------------------------
# Without S3, uploads stay on local disk (backend/uploads/). Without Redis,
# caching is in-memory. Without Sentry, errors go to the local error log.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_BASE=
REDIS_URL=
SENTRY_DSN=

# --- Admin bootstrap + backup API (optional) ---------------------------------
# Create the first admin from environment instead of the in-app setup screen.
EDUVERSE_BOOTSTRAP_ADMIN_EMAIL=
EDUVERSE_BOOTSTRAP_ADMIN_PASSWORD=
# Service key that may download backups without a login (automated backups).
BACKUP_API_KEY=
